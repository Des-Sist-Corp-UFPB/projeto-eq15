generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COMMON
  INSTITUTIONALIZED
  PROFESSOR
  ADMIN
}

enum InspectionLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum InspectionLogDirection {
  IN
  OUT
  ERROR
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(COMMON)
  canUpload     Boolean  @default(false)
  emailVerified Boolean  @default(false)
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]              @relation("AuditActor")
  materiaisInstrucionais      MaterialInstrucional[]
  emailVerificationTokens     EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole Role?
  targetId  String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])
}

// ── Materiais Instrucionais ────────────────────────────────────────────────────

enum MIStatus {
  PENDING_REVIEW // aguardando aprovação docente
  APPROVED       // aprovado e disponível publicamente
  REJECTED       // rejeitado com justificativa
}

model MaterialInstrucional {
  id               String   @id @default(uuid())
  title            String
  originalFileName String   // nome original do arquivo enviado pelo usuário
  storageKey       String   @unique // chave do objeto no MinIO
  mimeType         String
  sizeBytes        Int
  status           MIStatus @default(PENDING_REVIEW)
  uploadedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([status])
}

// ── Observabilidade ───────────────────────────────────────────────────────────

// Rastreio de ciclo de vida de requisições HTTP (observabilidade)
model InspectionLog {
  id        String                 @id @default(uuid())
  requestId String                 // correlaciona todos os logs de uma mesma requisição
  level     InspectionLogLevel     @default(INFO)
  context   String                 // ex: "createUserController"
  direction InspectionLogDirection // IN | OUT | ERROR
  payload   Json?                  // dados de entrada, saída ou detalhes do erro
  createdAt DateTime               @default(now())

  @@index([requestId])
}
