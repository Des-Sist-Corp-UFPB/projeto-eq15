generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COMMON
  INSTITUTIONALIZED
  PROFESSOR
  ADMIN
}

enum InspectionLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum InspectionLogDirection {
  IN
  OUT
  ERROR
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(COMMON)
  canUpload     Boolean  @default(false)
  emailVerified Boolean  @default(false)
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole Role?
  targetId  String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])
}

// Rastreio de ciclo de vida de requisições HTTP (observabilidade)
model InspectionLog {
  id        String                 @id @default(uuid())
  requestId String                 // correlaciona todos os logs de uma mesma requisição
  level     InspectionLogLevel     @default(INFO)
  context   String                 // ex: "createUserController"
  direction InspectionLogDirection // IN | OUT | ERROR
  payload   Json?                  // dados de entrada, saída ou detalhes do erro
  createdAt DateTime               @default(now())

  @@index([requestId])
}
